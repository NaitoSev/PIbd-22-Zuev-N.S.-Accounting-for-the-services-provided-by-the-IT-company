{
  "ConnectionStrings": {
    "Accounting": "Server=(localdb)\\MSSQLLocalDB;Database=ItServiceAccountingLab2;Integrated Security=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/accounting-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
